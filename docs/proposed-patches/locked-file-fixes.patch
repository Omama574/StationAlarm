+++ b/app/src/main/java/com/omama/stationalarm/service/gps/FixFreshness.kt
@@ -0,0 +1,36 @@
+package com.omama.stationalarm.service.gps
+
+/**
+ * Rejects fixes that must not drive an alarm decision because they are old or arrive out of order.
+ *
+ * Typical offender: the cached `lastLocation` read right after a reboot. It can be hours old, and it can be
+ * delivered *after* a fresh fix — if it happens to lie inside the alert radius it would ring the alarm.
+ *
+ * Times are `elapsedRealtimeNanos` (monotonic, immune to clock changes).
+ */
+class FixFreshness(private val maxAgeNs: Long = DEFAULT_MAX_AGE_NS) {
+
+    enum class Verdict { OK, STALE, OUT_OF_ORDER }
+
+    private var newestNs = 0L
+
+    /** Non-mutating: is a fix stamped [fixNs] recent enough to use at time [nowNs]? */
+    fun isFresh(nowNs: Long, fixNs: Long): Boolean = fixNs <= 0L || nowNs - fixNs <= maxAgeNs
+
+    /** Judges a fix and, if it is acceptable, remembers it as the newest one seen. */
+    @Synchronized
+    fun check(nowNs: Long, fixNs: Long): Verdict {
+        if (fixNs <= 0L) return Verdict.OK          // the provider did not stamp it; nothing to judge it by
+        if (nowNs - fixNs > maxAgeNs) return Verdict.STALE
+        if (fixNs < newestNs) return Verdict.OUT_OF_ORDER
+        // Never remember a timestamp later than "now": one fix stamped in the future by a faulty provider would
+        // otherwise make every real fix look out of order until the clock caught up, blinding the alarm.
+        newestNs = minOf(fixNs, nowNs)
+        return Verdict.OK
+    }
+
+    companion object {
+        /** Two minutes: at train speed, older than this the position is several km behind the train. */
+        const val DEFAULT_MAX_AGE_NS = 120_000_000_000L
+    }
+}
diff --git a/app/src/main/java/com/omama/stationalarm/util/AlarmRecovery.kt b/app/src/main/java/com/omama/stationalarm/util/AlarmRecovery.kt

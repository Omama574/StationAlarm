+package com.omama.stationalarm.util
+
+import com.omama.stationalarm.util.AlarmRecovery.Action
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class AlarmRecoveryTest {
+
+    private val minute = 60_000L
+    private val now = 1_700_000_000_000L
+
+    @Test
+    fun anAlarmThatRangAMinuteAgoIsResumed() {
+        assertEquals(Action.RESUME, AlarmRecovery.decide(now - minute, now))
+    }
+
+    @Test
+    fun thirtyMinutesIsStillResumedAndThirtyOneIsConsumed() {
+        assertEquals(Action.RESUME, AlarmRecovery.decide(now - 30 * minute, now))
+        assertEquals(Action.CONSUME, AlarmRecovery.decide(now - 31 * minute, now))
+    }
+
+    @Test
+    fun anOldAlarmIsConsumedNotRearmed() {
+        assertEquals(Action.CONSUME, AlarmRecovery.decide(now - 5 * 60 * minute, now))
+    }
+
+    @Test
+    fun anUnknownTriggerTimeIsConsumed() {
+        assertEquals(Action.CONSUME, AlarmRecovery.decide(null, now))
+    }
+
+    @Test
+    fun aTimestampInTheFutureIsNotTrusted() {
+        assertEquals(Action.CONSUME, AlarmRecovery.decide(now + minute, now))
+    }
+}

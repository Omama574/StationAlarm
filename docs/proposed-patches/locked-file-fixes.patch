+++ b/app/src/main/java/com/omama/stationalarm/util/AlarmRecovery.kt
@@ -0,0 +1,28 @@
+package com.omama.stationalarm.util
+
+/**
+ * What to do with an alarm that is still `ALERTING` when the service (re)starts or the phone boots.
+ *
+ * `ALERTING` is only ever left by the user's Dismiss, a manual pause, the ring timeout or a delete — so a row
+ * that is still `ALERTING` at start-up means the ring was **interrupted** (process killed, battery died,
+ * crash) before the user acknowledged it. The previous behaviour reset every such row to `MONITORING`, which
+ * silently lost the unacknowledged ring and left the alarm armed to ring again on the next approach.
+ *
+ * Instead, using the already-persisted `lastTriggeredAt`:
+ *  - rang recently (within [MAX_AGE_MS]) -> [Action.RESUME]: keep it `ALERTING`, the service rings again;
+ *  - anything older (or unknown)        -> [Action.CONSUME]: it has run its course, mark it `PAUSED`
+ *    rather than re-arming it.
+ */
+object AlarmRecovery {
+
+    const val MAX_AGE_MS = 30 * 60_000L
+
+    enum class Action { RESUME, CONSUME }
+
+    fun decide(lastTriggeredAtMs: Long?, nowMs: Long, maxAgeMs: Long = MAX_AGE_MS): Action {
+        if (lastTriggeredAtMs == null) return Action.CONSUME
+        val ageMs = nowMs - lastTriggeredAtMs
+        // A negative age means the clock moved backwards; do not trust it.
+        return if (ageMs in 0..maxAgeMs) Action.RESUME else Action.CONSUME
+    }
+}

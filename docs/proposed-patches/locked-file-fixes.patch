diff --git a/app/src/main/java/com/omama/stationalarm/receiver/GeofenceIds.kt b/app/src/main/java/com/omama/stationalarm/receiver/GeofenceIds.kt
new file mode 100644
index 0000000..1e2667b
--- /dev/null
+++ b/app/src/main/java/com/omama/stationalarm/receiver/GeofenceIds.kt
@@ -0,0 +1,32 @@
+package com.omama.stationalarm.receiver
+
+/**
+ * Parses geofence request IDs of the form `geofence_<stationId>_<layer>` (built in
+ * [com.omama.stationalarm.geofence.GeofenceManager.buildGeofence]).
+ *
+ * The previous parser used `split("_", limit = 3)`, which assumes the station ID contains no underscore. Geocoder
+ * IDs (`liq_481312177`) do, so for those alarms the receiver looked up station `liq`, found nothing armed, and
+ * dropped every hardware geofence event. The layer is always the text after the **last** underscore and always
+ * one of a known set, so parse from the end instead — which also keeps any alarm created before IDs were
+ * sanitised working.
+ */
+internal object GeofenceIds {
+
+    private const val PREFIX = "geofence_"
+
+    private val LAYERS = setOf(
+        "level1", "level2", "level3", "level4", "level5", "level6", "level7", "level8", "alert"
+    )
+
+    data class Parsed(val stationId: String, val layer: String)
+
+    fun parse(requestId: String): Parsed? {
+        if (!requestId.startsWith(PREFIX)) return null
+        val body = requestId.substring(PREFIX.length)
+        val cut = body.lastIndexOf('_')
+        if (cut <= 0 || cut == body.lastIndex) return null
+        val layer = body.substring(cut + 1)
+        if (layer !in LAYERS) return null
+        return Parsed(stationId = body.substring(0, cut), layer = layer)
+    }
+}

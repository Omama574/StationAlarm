+    suspend fun recoverInterruptedAlarms(): Pair<Int, Int> {
+        val now = System.currentTimeMillis()
+        var resumed = 0
+        var consumed = 0
+        for (row in getAllActiveStationsList().filter { it.status == "ALERTING" }) {
+            when (AlarmRecovery.decide(row.lastTriggeredAt, now)) {
+                AlarmRecovery.Action.RESUME -> resumed++
+                AlarmRecovery.Action.CONSUME -> {
+                    database.activeStationDao().updateStatus(row.stationId, "PAUSED")
+                    consumed++
+                }
+            }
+        }
+        if (resumed > 0 || consumed > 0) {
+            Logger.breadcrumb("ALERTING_RECOVERED", extra = "resumed=$resumed consumed=$consumed")
+            Analytics.event("interrupted_alarm_recovered") {
+                putInt("resumed", resumed)

+package com.omama.stationalarm.service.gps
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AlarmMathTest {
+
+    @Test
+    fun goodGpsFixKeepsItsTinyCredit() {
+        assertEquals(0.02, AlarmMath.accuracyCreditKm(accuracyKm = 0.02, radiusKm = 5.0), 1e-9)
+    }
+
+    @Test
+    fun poorFixCreditIsCappedAtAQuarterOfTheRadius() {
+        assertEquals(1.25, AlarmMath.accuracyCreditKm(accuracyKm = 3.0, radiusKm = 5.0), 1e-9)
+        assertEquals(0.75, AlarmMath.accuracyCreditKm(accuracyKm = 3.0, radiusKm = 3.0), 1e-9)
+    }
+
+    @Test
+    fun creditIsNeverMoreThanOneAndAHalfKilometres() {
+        assertEquals(1.5, AlarmMath.accuracyCreditKm(accuracyKm = 10.0, radiusKm = 20.0), 1e-9)
+    }
+
+    @Test
+    fun negativeAccuracyGivesNoCredit() {
+        assertEquals(0.0, AlarmMath.accuracyCreditKm(accuracyKm = -1.0, radiusKm = 5.0), 1e-9)
+    }
+
+    @Test
+    fun aFiveKmAccurateFixNineKmAwayNoLongerRingsAFiveKmAlarm() {
+        // Old rule: 9.9 - 5.0 = 4.9 <= 5.0  -> rang 4.9 km early.
+        val effective = AlarmMath.effectiveDistanceKm(distanceKm = 9.9, accuracyKm = 5.0, radiusKm = 5.0)
+        assertTrue("effective=$effective", effective > 5.0)
+    }
+
+    @Test
+    fun aGoodFixStillRingsAtTheRadius() {
+        val effective = AlarmMath.effectiveDistanceKm(distanceKm = 5.01, accuracyKm = 0.02, radiusKm = 5.0)
+        assertTrue("effective=$effective", effective <= 5.0)
+    }
+
+    @Test
+    fun surelyInsideRequiresTheWholeAccuracyCircleInside() {
+        assertTrue(AlarmMath.isSurelyInside(distanceKm = 3.0, accuracyKm = 0.05, radiusKm = 5.0))
+        assertFalse(AlarmMath.isSurelyInside(distanceKm = 4.9, accuracyKm = 0.5, radiusKm = 5.0))   // ambiguous
+        assertFalse(AlarmMath.isSurelyInside(distanceKm = 6.0, accuracyKm = 0.02, radiusKm = 5.0))  // outside
+    }
+
+    @Test
+    fun anAmbiguousFixNearTheBoundaryDoesNotSuppressTheAlarm() {
+        // Approaching trip, first fix is a 1 km-accurate cell fix at 5.5 km from a 5 km radius.
+        // Old rule treated it as "inside" (5.5 - 1.0 <= 5) and waited for an exit that never came.
+        assertFalse(AlarmMath.isSurelyInside(distanceKm = 5.5, accuracyKm = 1.0, radiusKm = 5.0))
+    }
+}
diff --git a/app/src/test/java/com/omama/stationalarm/service/gps/FixFreshnessTest.kt b/app/src/test/java/com/omama/stationalarm/service/gps/FixFreshnessTest.kt

@@ -0,0 +1,38 @@
+package com.omama.stationalarm.service.gps
+
+/**
+ * Pure decision rules for the GPS alarm path, free of Android types so they can be unit-tested on the JVM.
+ * [com.omama.stationalarm.service.LocationService] delegates to these.
+ */
+object AlarmMath {
+
+    /** Most benefit of the doubt a fix's reported accuracy may buy, in km. */
+    const val MAX_ACCURACY_CREDIT_KM = 1.5
+
+    /** Most of the alert radius a fix's accuracy may buy. */
+    const val MAX_ACCURACY_CREDIT_FRACTION = 0.25
+
+    /**
+     * How many km closer than reality the alarm is allowed to *assume* the user is, because the fix is imprecise.
+     *
+     * The alarm is deliberately biased early (a late alarm is worse than an early one), but the bias used to be
+     * the full reported accuracy with no upper limit: a 5 km-accurate cell fix at 9.9 km from a 5 km alert radius
+     * rang the alarm 4.9 km early. The credit is now capped at a quarter of the radius and at 1.5 km. For a good GPS
+     * fix (tens of metres) nothing changes.
+     */
+    fun accuracyCreditKm(accuracyKm: Double, radiusKm: Double): Double =
+        minOf(accuracyKm, radiusKm * MAX_ACCURACY_CREDIT_FRACTION, MAX_ACCURACY_CREDIT_KM).coerceAtLeast(0.0)
+
+    /** The distance the alarm compares with the alert radius. */
+    fun effectiveDistanceKm(distanceKm: Double, accuracyKm: Double, radiusKm: Double): Double =
+        distanceKm - accuracyCreditKm(accuracyKm, radiusKm)
+
+    /**
+     * True only when even the far edge of the accuracy circle is inside the radius. This is the one case in
+     * which "the alarm was armed while already inside the radius" may suppress it until the user leaves; an
+     * ambiguous fix near the boundary must not (it used to, which could silence an alarm for a user who was
+     * in fact still approaching).
+     */
+    fun isSurelyInside(distanceKm: Double, accuracyKm: Double, radiusKm: Double): Boolean =
+        distanceKm + accuracyKm <= radiusKm
+}
diff --git a/app/src/main/java/com/omama/stationalarm/service/gps/FixFreshness.kt b/app/src/main/java/com/omama/stationalarm/service/gps/FixFreshness.kt

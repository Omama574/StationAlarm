+                // Do not retry — and log — the refused switch on every later update.
+                typeSwitchRefused = true
             }
         } else {
             notifications.notifyForeground(notif)
         }
     }
 
+    private fun hasLocationPermission(): Boolean =
+        ActivityCompat.checkSelfPermission(this, android.Manifest.permission.ACCESS_FINE_LOCATION) == PackageManager.PERMISSION_GRANTED ||
+            ActivityCompat.checkSelfPermission(this, android.Manifest.permission.ACCESS_COARSE_LOCATION) == PackageManager.PERMISSION_GRANTED
+
+    /**
+     * Calls startForeground() with the wanted type and, if the platform refuses it, with the other one.
+     * Returns false only when neither is accepted. Catches SecurityException (missing permission) and
+     * ForegroundServiceStartNotAllowedException (API 31+) so a platform refusal can never crash the service —
+     * especially not at the moment an alarm is due.
+     */
+    private fun startForegroundSafely(notif: Notification, locationType: Boolean): Boolean {
+        val id = ServiceNotifications.FOREGROUND_NOTIFICATION_ID
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.Q) {
+            return try {
+                startForeground(id, notif)
+                locationForegroundActive = locationType
+                true
+            } catch (e: Exception) {
+                Logger.error("FGS_START_FAILED", e)
+                false
+            }
+        }
+        val location = ServiceInfo.FOREGROUND_SERVICE_TYPE_LOCATION
+        val media = ServiceInfo.FOREGROUND_SERVICE_TYPE_MEDIA_PLAYBACK
+        for (type in if (locationType) intArrayOf(location, media) else intArrayOf(media, location)) {
+            try {
+                startForeground(id, notif, type)
+                locationForegroundActive = (type == location)
+                return true
+            } catch (e: Exception) {
+                Logger.error("FGS_START_FAILED", e, extra = "type=$type")
+            }
+        }
+        return false
+    }
+
     // ============================
     //     GPS ENGINE
     // ============================

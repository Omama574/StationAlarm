@@ -0,0 +1,81 @@
+package com.omama.stationalarm.service.gps
+
+import com.omama.stationalarm.service.gps.FixFreshness.Verdict
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class FixFreshnessTest {
+
+    private val sec = 1_000_000_000L
+
+    // elapsedRealtime since boot: ~27 hours of uptime, so "hours ago" is still a positive timestamp.
+    private val now = 100_000 * sec
+
+    @Test
+    fun aFreshFixIsAccepted() {
+        assertEquals(Verdict.OK, FixFreshness().check(now, now - 5 * sec))
+    }
+
+    @Test
+    fun aFixExactlyAtTheLimitIsAcceptedAndOneNanosecondOverIsStale() {
+        val g = FixFreshness(maxAgeNs = 120 * sec)
+        assertEquals(Verdict.OK, g.check(now, now - 120 * sec))
+        assertEquals(Verdict.STALE, FixFreshness(maxAgeNs = 120 * sec).check(now, now - 120 * sec - 1))
+    }
+
+    @Test
+    fun aCachedFixFromHoursAgoIsStale() {
+        assertEquals(Verdict.STALE, FixFreshness().check(now, now - 3 * 3600 * sec))
+    }
+
+    @Test
+    fun anOlderFixArrivingAfterANewerOneIsRejected() {
+        val g = FixFreshness()
+        assertEquals(Verdict.OK, g.check(now, now - 2 * sec))
+        assertEquals(Verdict.OUT_OF_ORDER, g.check(now, now - 30 * sec))
+    }
+
+    @Test
+    fun aNewerFixAfterAnOlderOneIsAccepted() {
+        val g = FixFreshness()
+        assertEquals(Verdict.OK, g.check(now, now - 30 * sec))
+        assertEquals(Verdict.OK, g.check(now, now - 2 * sec))
+    }
+
+    @Test
+    fun aRejectedStaleFixDoesNotBecomeTheNewestOne() {
+        val g = FixFreshness()
+        assertEquals(Verdict.STALE, g.check(now, now - 600 * sec))
+        assertEquals(Verdict.OK, g.check(now, now - 20 * sec))
+    }
+
+    @Test
+    fun aDuplicateTimestampIsAccepted() {
+        val g = FixFreshness()
+        assertEquals(Verdict.OK, g.check(now, now - 5 * sec))
+        assertEquals(Verdict.OK, g.check(now, now - 5 * sec))
+    }
+
+    @Test
+    fun aFixStampedInTheFutureDoesNotBlindLaterFixes() {
+        val g = FixFreshness()
+        assertEquals(Verdict.OK, g.check(now, now + 600 * sec))   // faulty provider: 10 minutes ahead
+        assertEquals(Verdict.OK, g.check(now + 1 * sec, now + 1 * sec))  // the next real fix must still be accepted
+    }
+
+    @Test
+    fun anUnstampedFixIsNotJudged() {
+        assertEquals(Verdict.OK, FixFreshness().check(now, 0L))
+    }
+
+    @Test
+    fun isFreshDoesNotChangeState() {
+        val g = FixFreshness()
+        assertTrue(g.isFresh(now, now - 10 * sec))
+        assertFalse(g.isFresh(now, now - 500 * sec))
+        // Nothing was recorded, so an "older" fix is still fine afterwards.
+        assertEquals(Verdict.OK, g.check(now, now - 60 * sec))
+    }
+}

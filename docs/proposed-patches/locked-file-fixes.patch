+package com.omama.stationalarm.receiver
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class GeofenceIdsTest {
+
+    @Test
+    fun railwayCodeParses() {
+        assertEquals(GeofenceIds.Parsed("NDLS", "alert"), GeofenceIds.parse("geofence_NDLS_alert"))
+        assertEquals(GeofenceIds.Parsed("PUNE", "level5"), GeofenceIds.parse("geofence_PUNE_level5"))
+    }
+
+    @Test
+    fun geocoderIdWithUnderscoresParsesToTheWholeStationId() {
+        // The case the old split("_", limit = 3) got wrong: it returned station "liq", layer "481312177_alert".
+        assertEquals(
+            GeofenceIds.Parsed("liq_481312177", "alert"),
+            GeofenceIds.parse("geofence_liq_481312177_alert")
+        )
+        assertEquals(
+            GeofenceIds.Parsed("liq_rev_481312177", "level2"),
+            GeofenceIds.parse("geofence_liq_rev_481312177_level2")
+        )
+    }
+
+    @Test
+    fun sanitisedHyphenIdParses() {
+        assertEquals(GeofenceIds.Parsed("liq-481312177", "alert"), GeofenceIds.parse("geofence_liq-481312177_alert"))
+        assertEquals(GeofenceIds.Parsed("manual-1718000000000", "level8"), GeofenceIds.parse("geofence_manual-1718000000000_level8"))
+    }
+
+    @Test
+    fun everyLayerNameTheManagerCanProduceIsRecognised() {
+        for (layer in listOf("level1", "level2", "level3", "level4", "level5", "level6", "level7", "level8", "alert")) {
+            assertEquals(layer, GeofenceIds.parse("geofence_X_$layer")?.layer)
+        }
+    }
+
+    @Test
+    fun malformedIdsAreRejected() {
+        assertNull(GeofenceIds.parse(""))
+        assertNull(GeofenceIds.parse("NDLS_alert"))                // missing prefix
+        assertNull(GeofenceIds.parse("geofence_NDLS"))              // no layer
+        assertNull(GeofenceIds.parse("geofence__alert"))            // empty station id
+        assertNull(GeofenceIds.parse("geofence_NDLS_level9"))       // unknown layer
+        assertNull(GeofenceIds.parse("geofence_NDLS_"))             // empty layer
+    }
+}

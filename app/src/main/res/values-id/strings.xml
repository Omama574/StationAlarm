    <string name="permission_location_title">Akses Lokasi Diperlukan</string>
    <string name="permission_location_body">StationAlarm membutuhkan akses lokasi \'Izinkan sepanjang waktu\' untuk membunyikan alarm saat Anda mendekati tujuan ketika aplikasi ditutup atau ponsel terkunci.</string>
    <string name="permission_location_steps">• Ketuk \'Pengaturan\' di bawah\n• Ketuk \'Izin\'\n• Pilih \'Lokasi\'\n• Pilih \'Izinkan sepanjang waktu\'</string>
    <string name="permission_notifications_title">Aktifkan Notifikasi</string>
    <string name="permission_notifications_body">StationAlarm membutuhkan izin notifikasi untuk menampilkan alarm saat ponsel terkunci. Tanpanya, alarm bisa berbunyi diam-diam di latar belakang dan Anda melewatkan pemberhentian.</string>

    <string name="gps_disabled_title">GPS Nonaktif</string>
    <string name="gps_disabled_body">Izinkan StationAlarm mengaktifkan layanan lokasi untuk pelacakan yang akurat.</string>
    <string name="gps_disabled_turn_on">Aktifkan GPS</string>

    <string name="volume_low_title">Volume alarm rendah</string>
    <string name="volume_low_body">Volume alarm Anda di bawah 50%. Naikkan sekarang agar alarm dapat membangunkan Anda dengan andal.</string>
    <string name="volume_low_increase">Naikkan ke maksimum</string>
    <string name="volume_low_keep">Pertahankan saat ini</string>

    <string name="battery_sheet_title">Jaga keandalan alarm</string>
    <string name="battery_sheet_body">Anda baru saja mengatur alarm — pastikan alarm benar-benar membangunkan Anda. Tanpa pengecualian baterai, Android dapat menidurkan StationAlarm dan alarm Anda bisa terlambat atau tidak berbunyi sama sekali.</string>

    <string name="permission_location_title">Acceso a ubicación requerido</string>
    <string name="permission_location_body">StationAlarm requiere acceso a la ubicación \'Permitir siempre\' para activar la alarma cuando te acerques a tu destino con la app cerrada o el teléfono bloqueado.</string>

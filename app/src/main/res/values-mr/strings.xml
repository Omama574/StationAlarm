    <!-- Permission dialogs -->
    <string name="permission_location_title">स्थान प्रवेश आवश्यक</string>
    <string name="permission_location_body">ॲप बंद असताना किंवा फोन लॉक असताना गंतव्यस्थानाजवळ आल्यावर अलार्म वाजवण्यासाठी StationAlarm ला \'नेहमी परवानगी द्या\' स्थान प्रवेश आवश्यक आहे.</string>
    <string name="permission_location_steps">• खाली \'सेटिंग्ज\' दाबा\n• \'परवानग्या\' दाबा\n• \'स्थान\' निवडा\n• \'नेहमी परवानगी द्या\' निवडा</string>
    <string name="permission_notifications_title">सूचना सक्षम करा</string>
    <string name="permission_notifications_body">फोन लॉक असताना अलार्म दाखवण्यासाठी StationAlarm ला सूचना परवानगी आवश्यक आहे. नसल्यास अलार्म शांतपणे वाजेल आणि तुम्ही स्टेशन चुकवाल.</string>


    <string name="permission_location_title">Locatietoegang vereist</string>
    <string name="permission_location_body">StationAlarm vereist \'Altijd toestaan\' locatietoegang om het alarm te laten afgaan wanneer je je bestemming nadert terwijl de app is gesloten of je telefoon is vergrendeld.</string>
    <string name="permission_location_steps">• Tik op \'Instellingen\' hieronder\n• Tik op \'Toestemmingen\'\n• Selecteer \'Locatie\'\n• Kies \'Altijd toestaan\'</string>
    <string name="permission_notifications_title">Meldingen inschakelen</string>
    <string name="permission_notifications_body">StationAlarm heeft meldingstoestemming nodig om alarmen te tonen terwijl je telefoon vergrendeld is. Zonder dit kan het alarm stilletjes op de achtergrond afgaan en mis je je stop.</string>

    <string name="gps_disabled_title">GPS uitgeschakeld</string>
    <string name="gps_disabled_body">Sta StationAlarm toe om locatieservices in te schakelen voor nauwkeurige tracking.</string>
    <string name="gps_disabled_turn_on">GPS inschakelen</string>

    <string name="volume_low_title">Alarmvolume is laag</string>
    <string name="volume_low_body">Uw alarmvolume is lager dan 50%. Zet het nu hoger zodat het alarm u betrouwbaar wekt.</string>
    <string name="volume_low_increase">Naar maximum verhogen</string>
    <string name="volume_low_keep">Huidig behouden</string>

    <string name="battery_sheet_title">Houd alarmen betrouwbaar</string>
    <string name="battery_sheet_body">U heeft zojuist een alarm ingesteld — laten we ervoor zorgen dat het u ook wekt. Zonder een batterij-uitzondering kan Android StationAlarm in slaap sturen en kan uw alarm te laat of helemaal niet afgaan.</string>

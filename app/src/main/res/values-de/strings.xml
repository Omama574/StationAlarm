    <string name="permission_location_title">Standortzugriff erforderlich</string>
    <string name="permission_location_body">StationAlarm benötigt \'Immer erlauben\' Standortzugriff, um den Alarm auszulösen, wenn Sie sich Ihrem Ziel nähern, während die App geschlossen oder das Telefon gesperrt ist.</string>
    <string name="permission_location_steps">• Tippen Sie unten auf \'Einstellungen\'\n• Tippen Sie auf \'Berechtigungen\'\n• Wählen Sie \'Standort\'\n• Wählen Sie \'Immer erlauben\'</string>
    <string name="permission_notifications_title">Benachrichtigungen aktivieren</string>
    <string name="permission_notifications_body">StationAlarm benötigt die Benachrichtigungsberechtigung, um Alarme anzuzeigen, wenn Ihr Telefon gesperrt ist. Ohne sie kann der Alarm lautlos im Hintergrund klingeln und Sie verpassen Ihre Haltestelle.</string>

    <string name="gps_disabled_title">GPS deaktiviert</string>
    <string name="gps_disabled_body">Bitte erlauben Sie StationAlarm, die Standortdienste für eine genaue Verfolgung zu aktivieren.</string>
    <string name="gps_disabled_turn_on">GPS aktivieren</string>

    <string name="volume_low_title">Alarmvolumen ist niedrig</string>
    <string name="volume_low_body">Ihr Alarmvolumen liegt unter 50 %. Erhöhen Sie es jetzt, damit der Alarm Sie zuverlässig weckt.</string>
    <string name="volume_low_increase">Auf Maximum erhöhen</string>
    <string name="volume_low_keep">Aktuell behalten</string>

    <string name="battery_sheet_title">Alarme zuverlässig halten</string>
    <string name="battery_sheet_body">Sie haben gerade einen Alarm eingestellt — stellen wir sicher, dass er Sie weckt. Ohne eine Akkuausnahme kann Android StationAlarm in den Ruhezustand versetzen und Ihr Alarm kann verzögert oder gar nicht ausgelöst werden.</string>
    <string name="battery_sheet_open">Einstellungen öffnen</string>
    <string name="battery_sheet_skip">Jetzt überspringen</string>
    <string name="battery_sheet_dont_ask_again">Nicht mehr fragen</string>

